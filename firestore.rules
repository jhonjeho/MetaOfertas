rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Reglas para productos
    match /productos/{productId} {
      allow read: if true;

      // Escritura solo para administradores (claim custom 'admin' = true)
      allow create, update, delete: if request.auth != null && request.auth.token.admin == true

      // Validaciones de datos
      function validQuantity() {
        return request.resource.data.keys().hasAll(['quantity']) == false ||
               (request.resource.data.quantity is int && request.resource.data.quantity >= 0);
      }

      allow create, update: if request.auth != null && request.auth.token.admin == true && validQuantity();
    }

    // Config (admins list)
    match /config/{docId} {
      allow read: if request.auth != null && request.auth.token.admin == true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
  }
}
